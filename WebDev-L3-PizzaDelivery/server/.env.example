# Copy this file to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB connection string (MongoDB Atlas or local instance)
MONGO_URI=mongodb://127.0.0.1:27017/pizza-delivery

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin - used for CORS and for building email links
CLIENT_URL=http://localhost:5173

# Resend (https://resend.com) - transactional email provider
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM="Pizza House <onboarding@resend.dev>"

# Razorpay (https://razorpay.com) - test-mode API keys from the Razorpay dashboard.
# Payment creation/verification return a clear error until both are set.
RAZORPAY_KEY_ID=replace-with-your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-test-key-secret

# Admin bootstrap - used by `npm run seed:admin`, never by public signup.
# ADMIN_EMAIL is also where the low-stock cron job (jobs/lowStockCron.job.js)
# sends its alert emails.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Cron schedule for the low-stock inventory check, in standard cron syntax.
# Optional - defaults to every minute ("* * * * *"), which is deliberately
# frequent so the feature is easy to demonstrate. For production, use
# something coarser, e.g. every 15 minutes or hourly.
# LOW_STOCK_CRON_SCHEDULE=*/15 * * * *
