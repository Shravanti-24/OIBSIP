# Copy this file to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB connection string (MongoDB Atlas or local instance)
MONGO_URI=mongodb://127.0.0.1:27017/pizza-delivery

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin - used for CORS and for building email links
CLIENT_URL=http://localhost:5173

# Resend (https://resend.com) - transactional email provider
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM="Pizza Delivery <onboarding@resend.dev>"

# Admin bootstrap - used only by `npm run seed:admin`, never by public signup
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
